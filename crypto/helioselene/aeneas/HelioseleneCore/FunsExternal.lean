/-! ## Sanity checks -/

section SanityChecks
open crypto_bigint.uint.Uint HelioseleneModel

-- toNat/ofNat round-trip on a 2-limb value straddling the limb boundary
#guard (ofNat 2#usize 0x10000000000000005).toNat == 0x10000000000000005
-- ofNat wraps mod 2^(64·LIMBS)
#guard (ofNat 1#usize (2 ^ 64 + 3)).toNat == 3

-- mac on small numbers: 2 + 3·4 + 5 = 19
#guard match crypto_bigint.limb.mul.Limb.mac 2#u64 3#u64 4#u64 5#u64 with
  | ok (lo, hi) => lo.val == 19 && hi.val == 0
  | _ => false
-- mac at the extreme: (2^64-1) + (2^64-1)² + (2^64-1) = 2^128 - 1 (no overflow)
#guard match crypto_bigint.limb.mul.Limb.mac limbAllOnes limbAllOnes limbAllOnes limbAllOnes with
  | ok (lo, hi) => lo.val == 2 ^ 64 - 1 && hi.val == 2 ^ 64 - 1
  | _ => false

-- sbb borrow conventions on 1-limb values: 5 - 7 underflows, borrow-out = all-ones
#guard match crypto_bigint.uint.sub.Uint.sbb (ofNat 1#usize 5) (ofNat 1#usize 7) 0#u64 with
  | ok (d, bo) => d.toNat == 2 ^ 64 - 2 && bo.val == 2 ^ 64 - 1
  | _ => false
-- borrow-in is read from the TOP bit of the borrow limb: 7 - 5 - 1 = 1, no borrow-out
#guard match crypto_bigint.uint.sub.Uint.sbb (ofNat 1#usize 7) (ofNat 1#usize 5) limbAllOnes with
  | ok (d, bo) => d.toNat == 1 && bo.val == 0
  | _ => false

-- from_be_hex parses a 1-limb literal
#guard match crypto_bigint.uint.encoding.Uint.from_be_hex 1#usize (toStr "00000000000000fF") with
  | ok u => u.toNat == 0xff
  | _ => false
-- from_be_hex panics on a wrong-length string
#guard match crypto_bigint.uint.encoding.Uint.from_be_hex 1#usize (toStr "ff") with
  | .ok _ => false
  | _ => true

-- limb shifts panic at width 64, work below it
#guard match crypto_bigint.limb.Limb.Insts.CoreOpsBitShlUsizeLimb.shl 1#u64 63#usize with
  | ok l => l.val == 2 ^ 63
  | _ => false
#guard match crypto_bigint.limb.Limb.Insts.CoreOpsBitShlUsizeLimb.shl 1#u64 64#usize with
  | .fail _ => true
  | _ => false

-- Choice::from maps 0 to false and nonzero to true
#guard subtle.Choice.Insts.CoreConvertFromU8.from 0#u8 == ok false
#guard subtle.Choice.Insts.CoreConvertFromU8.from 1#u8 == ok true

end SanityChecks

/-! ## Additions for the widened translation scope (2026-07-07): `verified::sqrt` +
    the Selene group-law core (`point::selene`).

    Two kinds of entries follow, in template order:

    * **Concrete models** (`def`) for every external the goal scope actually calls
      (the `subtle` `Choice`/`CtOption` combinators, four `crypto-bigint` `Uint`
      items, and the trivially-empty derived-`Eq` helpers), each documented against
      the crate sources exactly like the models above.
